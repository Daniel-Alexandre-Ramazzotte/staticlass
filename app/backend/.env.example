DATABASE_URL=postgresql://staticlass:staticlass123@localhost:5432/staticlass
SECRET_KEY=staticlass-dev-secret-key-2026

# URL pública onde app/web está hospedado — usada no link de convite de turma
# (send_invite_email → {APP_BASE_URL}/complete-invite?token=...).
# Sem essa variável em produção, o email de convite manda um link localhost quebrado.
APP_BASE_URL=http://localhost:5173

# Credenciais SMTP para envio de email (verificação de conta, reset de senha, convite de turma)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER_NAME=Staticlass

